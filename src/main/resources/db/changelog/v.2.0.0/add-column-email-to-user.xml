<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="add-unique-index-email" author="Sergei">
        <addColumn tableName="user_entity" schemaName="public">
            <column name="email" type="varchar(128)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <createIndex tableName="user_entity" schemaName="public" indexName="uq_email" unique="true">
            <column name="email"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="user_entity" schemaName="public" indexName="uq_email"/>
            <dropColumn tableName="user_entity" schemaName="public" columnName="email"/>
        </rollback>
    </changeSet>

</databaseChangeLog>