<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="add-user-5" author="Sergei">
        <insert tableName="user_entity" schemaName="public">
            <column name="name" value="Alice"/>
            <column name="surname" value="Johnson"/>
            <column name="description" value="Third user description"/>
        </insert>
        <rollback>
            <delete tableName="user_entity" schemaName="public">
                <where>name = 'Alice' AND surname = 'Johnson'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>